# ===========================================================================
# Evolution API — minimal production env for Dokploy
# ---------------------------------------------------------------------------
# Replace every *** CHANGE ME *** value before deploying.
# Everything else uses the API's built-in defaults — keep it lean.
# ===========================================================================

# ---- Server ---------------------------------------------------------------
SERVER_TYPE=http
SERVER_PORT=8080
# Public URL Dokploy/Traefik will route to this service. Used for QR codes,
# webhooks, and the manager UI base path. Must match the domain you attach.
SERVER_URL=https://evo.example.com   # *** CHANGE ME ***

# ---- Auth -----------------------------------------------------------------
# Global API key — send as `apikey` header on every request.
# Generate one with: openssl rand -hex 32
AUTHENTICATION_API_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_KEY   # *** CHANGE ME ***
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# ---- Database (existing Postgres) -----------------------------------------
# Point this at your existing Postgres. Examples:
#   - Same Dokploy instance:   postgresql://user:pass@<dokploy-pg-service>:5432/evolution_db?schema=evolution_api
#   - Managed / external host: postgresql://user:pass@db.your-host.com:5432/evolution_db?schema=evolution_api
# The `schema=evolution_api` qualifier is recommended — keeps Evolution's
# tables namespaced and avoids collisions with anything else in the DB.
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://USER:PASS@HOST:5432/evolution_db?schema=evolution_api   # *** CHANGE ME ***
DATABASE_CONNECTION_CLIENT_NAME=evolution_prod

# ---- Cache (existing Redis) -----------------------------------------------
# Point this at your existing Redis. The trailing `/0` selects DB index 0;
# change it if you want isolation from other apps sharing this Redis.
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://USER:PASS@HOST:6379/0   # *** CHANGE ME ***
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ---- App basics -----------------------------------------------------------
LANGUAGE=en
LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=true
LOG_BAILEYS=error
DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# CORS — tighten this once you know your manager / client origin.
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# Built-in websocket (lightweight, no extra service needed).
WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=false

# Feature toggles from this fork (keep manager fully functional).
INTEGRATIONS=true
CHAT_UI=true
