# ===========================================================================
# Evolution API — paste-template for Dokploy
# ---------------------------------------------------------------------------
# THIS FILE IS A TEMPLATE. It is NOT read by the container at runtime.
#
# The actual runtime env comes from Dokploy's "Environment" tab, which
# writes to .env next to docker-compose.prod.yml. The compose service is
# configured with `env_file: .env`, so whatever you put in the Dokploy UI
# is what the container sees.
#
# WORKFLOW:
#   1. Copy the contents of this file.
#   2. In Dokploy → your app → Environment tab → paste.
#   3. Edit the four values marked CHANGE-ME below.
#   4. Save → Redeploy.
#
# Inline comments (`# ...` after a value) are NOT allowed in env_file values.
# Every comment in this template is on its own line so it stays a comment.
# ===========================================================================


# ---------- Server ----------
SERVER_TYPE=http
SERVER_PORT=8080
# CHANGE-ME: public URL Dokploy/Traefik routes to this service.
SERVER_URL=https://evo.example.com


# ---------- Auth ----------
# CHANGE-ME: generate with `openssl rand -hex 32` and send as `apikey` header.
AUTHENTICATION_API_KEY=replace_with_a_long_random_hex_string
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false


# ---------- Database (your existing Postgres) ----------
# CHANGE-ME: full connection string to YOUR Postgres.
# Format: postgresql://user:password@host:port/database?schema=evolution_api
# Examples:
#   postgresql://evolution:S3cret@my-pg.internal:5001/evolution_db?schema=evolution_api
#   postgresql://evolution:S3cret@10.0.0.5:5001/evolution_db?schema=evolution_api
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://user:password@host:5001/evolution_db?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_prod


# ---------- Cache (your existing Redis) ----------
# CHANGE-ME: full Redis URI. Drop the user:pass@ part if your Redis has no auth.
# The trailing /0 selects DB index 0; bump it if you share Redis with other apps.
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://user:password@host:6379/0
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false


# ---------- App basics ----------
LANGUAGE=en
LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=true
LOG_BAILEYS=error
DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30


# ---------- CORS ----------
# Tighten ORIGIN once you know your manager / client domain(s).
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true


# ---------- Websocket ----------
WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=false


# ---------- Feature toggles (this fork) ----------
INTEGRATIONS=true
CHAT_UI=true
